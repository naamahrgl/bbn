---
import BaseLayout from '../../layouts/BaseLayout.astro';
const { params, url } = Astro;
const lang = params.lang;
const paymentUrl = new URL(url).searchParams.get('payment_url');
---

<BaseLayout lang={lang}>
  <div class="flex justify-center items-center min-h-[80vh] p-6">
    <iframe src={paymentUrl} width="350" height="800" style="border:0; box-shadow:0 0 10px #ccc; border-radius:1rem;" />
  </div>
</BaseLayout>

